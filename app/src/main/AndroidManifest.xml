<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.odin2.permission.RECEIVE_VIDEO_OUTPUT_PORT_CHANGE"/>
    <uses-permission android:name="com.retrostation.permission.RECEIVE_VIDEO_OUTPUT_PORT_CHANGE"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Auto-update: consultar as releases do GitHub e descarregar o APK novo. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recuo do auto-update quando o PServer não pode instalar: entrega o APK ao instalador do sistema. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        AUDITORIA DE SUPERFÍCIE EXPOSTA (componentes com android:exported="true")

        Cada componente exportado abaixo tem de o ser, e está protegido:
          * .main.MainActivity            — exportada por ser a atividade de arranque (LAUNCHER).
          * .tiles.ControllerTileService  — exportada porque é o SystemUI que a liga; protegida
          * .tiles.L2R2TileService          com android:permission="BIND_QUICK_SETTINGS_TILE",
                                            que só o sistema possui.
          * .service.ForegroundAppWatcherService — exportada porque é o sistema que a liga;
                                            protegida com "BIND_ACCESSIBILITY_SERVICE".
          * .tools.BootReceiver           — tem de ser exportado para receber BOOT_COMPLETED e
                                            MY_PACKAGE_REPLACED, que vêm do system_server (UID
                                            diferente; um receiver não exportado só recebe
                                            broadcasts do próprio processo). Ambas as ações são
                                            "protected broadcasts" — só o sistema as pode emitir —
                                            e o onReceive valida na mesma intent.action antes de
                                            fazer seja o que for.

        Tudo o resto (GamingOverlayService, OdinHubService) está exportado="false" de propósito:
        são arrancados só de dentro desta app.
    -->
    <application
        android:name=".OdinHubApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.OdinHub"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Partilha o APK descarregado pelo auto-update com o instalador do Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
        <activity
            android:name=".main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OdinHub"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tiles.ControllerTileService"
            android:exported="true"
            android:icon="@drawable/ic_face_buttons"
            android:label="@string/controllerStyle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.L2R2TileService"
            android:exported="true"
            android:icon="@drawable/ic_sliders"
            android:label="@string/l2r2mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- HUD DE DESEMPENHO -->
        <service
            android:name=".service.PerformanceHudService"
            android:enabled="true"
            android:exported="false" />

        <!-- SERVIÇO DA BARRA LATERAL (GAMING OVERLAY) -->
        <service
            android:name=".service.GamingOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="performance_monitoring" />
        </service>

        <!--
            MOTOR DE PERFORMANCE EM PRIMEIRO PLANO (OdinHubService).
            Faltava esta declaração: sem ela, `context.startService(Intent(context,
            OdinHubService::class.java))`/startForegroundService lançaria
            ActivityNotFoundException em tempo de execução, e o serviço de monitorização
            contínua nunca chegaria a arrancar num dispositivo real.
        -->
        <service
            android:name=".service.OdinHubService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="performance_monitoring" />
        </service>

        <!--
            SERVIÇO DE ACESSIBILIDADE (deteção de app em primeiro plano + atalho físico).
            Esta declaração faltava por completo: sem o intent-filter
            android.accessibilityservice.AccessibilityService, a permissão
            BIND_ACCESSIBILITY_SERVICE e o meta-data apontando para
            accessibility_service_config.xml, o Android nunca lista este serviço em
            Definições > Acessibilidade — ou seja, o utilizador não consegue sequer ativá-lo,
            e toda a lógica de App Overrides / interceção da tecla de atalho fica morta,
            independentemente do PerformanceManager estar correto.
        -->
        <service
            android:name=".service.ForegroundAppWatcherService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".tools.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>